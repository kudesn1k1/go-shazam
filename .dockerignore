# Test code — not part of runtime image.
# Note: server/internal/app/testendpoints.go is NOT excluded because
# server/internal/app/app.go references registerTestEndpoints. The function
# is runtime-gated by APP_ENV=test so it's safe to ship — the same image
# then runs in both prod and test compose.
**/*_test.go
**/integration_test.go
server/test/

